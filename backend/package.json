{
  "name": "profitic-backend",
  "version": "1.0.0",
  "description": "Backend indexer and REST API for the Profitic Solana prediction market",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "migrate": "psql $DATABASE_URL -f ../migrations/001_initial.sql"
  },
  "dependencies": {
