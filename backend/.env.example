# =============================================================================
# Profitic Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres connection string. The indexer stores all markets, trades,
# positions, and evidence logs here for fast off-chain querying.
DATABASE_URL=postgresql://profitic:profitic@localhost:5432/profitic

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# RPC endpoint used by the indexer to subscribe to program logs and fetch
# on-chain account data.  Use a dedicated RPC provider for production
# (Helius, Triton, QuickNode, etc.) — the public endpoint rate-limits.
SOLANA_RPC_URL=https://api.devnet.solana.com

# The deployed Profitic program ID (public key).
PROGRAM_ID=Prof1t1cPredMarket11111111111111111111111

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the Express HTTP + WebSocket server listens on.
PORT=3001

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Wallet address of the platform admin. Used to verify resolution authority
# and filter admin-only log events in the indexer.
ADMIN_WALLET=YourAdminPublicKeyHere
